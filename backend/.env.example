# 복사해서 backend/.env 로 쓰기 (.env는 커밋하지 않음)
# 공식 schema.sql · seed.sql 이 있는 공유 폴더 (예: OneDrive 카카오톡 받은 파일/database)
HM_DB_DIR=C:/Users/me/OneDrive/카카오톡 받은 파일/database

# 로컬 DB 계정 · 포트 (서버 실행 때도 같은 값을 DB_USER · DB_PASSWORD 환경변수로)
DB_USER=habit
DB_PASSWORD=habit
DB_PORT=5432

# AI 챗봇 (Gemini). 진짜 키는 backend/.env 에만 — 이 파일(.env.example)은 커밋되므로 값을 비워 둔다
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
